# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). These are safe to expose in the browser — they are
# NOT secret keys, just the public project URL and anon/publishable key.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
